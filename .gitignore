# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & packaging
build/
develop-eggs/
dist/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend dependencies & build outputs
node_modules/
frontend/dist/
frontend/.vite/
!frontend/src/lib/
!frontend/src/lib/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Static assets compiled into backend (generated during build)
backend/app/static/

# Application runtime storage (preserve .gitkeep)
downloads/*
!downloads/.gitkeep

# Sensitive cookie files (preserve .gitkeep)
cookies/*
!cookies/.gitkeep

# Environment and Secrets
.env
.env.local
.env.*.local

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Teamwork scratch runs (keep AGENTS.md in repo root)
.agents/teamwork/
